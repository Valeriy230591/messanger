{
  "name": "messanger",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=12.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:watch": "eslint src/**/*.ts --watch",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint:all": "npm run lint && npm run stylelint",
    "test": "mocha"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm-run-all test lint:all"
    }
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "chai": "^6.2.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@types/handlebars": "^4.0.40",
    "handlebars": "^4.7.8",
    "nanoid": "^5.1.6",
    "sass": "^1.93.2"
  }
}
